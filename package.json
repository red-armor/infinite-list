    "husky": "^8.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-react-native": "18.0.0",
    "jsdom": "~22.1.0",
    "lint-staged": "^13.0.3",
    "nx": "19.8.0",
    "prettier": "^2.8.4",
    "react-native-svg": "15.3.0",
    "react-native-svg-transformer": "1.3.0",
    "react-test-renderer": "18.2.0",
    "rimraf": "^3.0.2",
    "rollup": "^4.14.0",
    "storybook": "8.4.7",
    "swc-loader": "0.1.15",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsup": "^6.6.3",
    "typescript": "~5.5.2",
    "typescript-eslint": "^8.0.0",
    "verdaccio": "^5.0.4",
    "vite": "^5.0.0",
    "vite-plugin-dts": "~3.8.1",
