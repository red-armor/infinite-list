    "@testing-library/jest-native": "~5.4.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/react-native": "12.9.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/jest": "^29.5.14",
    "@types/node": "18.16.9",
    "@types/react": "18.3.22",
    "@types/react-dom": "18.3.7",
