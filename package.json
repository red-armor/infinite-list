{
  "name": "infinite-list",
  "version": "0.4.10",
  "description": "Data model for list rendering",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-armor/infinite-list.git"
  },
  "scripts": {
    "clean": "rm -rf dist && rm -rf .nx && pnpm run -r clean",
    "clean-modules": "rm -rf node_modules && pnpm -r exec rm -rf node_modules && pnpm -r exec rm -rf dist",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint:fix": "nx run-many -t lint",
    "lint": "eslint --ext js,ts,tsx .",
    "format": "nx run-many -t prettier --write ",
    "prepare": "husky install",
    "version": "changeset version && pnpm install --no-frozen-lockfile",
    "publish": "pnpm publish -r --access public",
    "dev:web": "nx storybook react",
    "dev:rn": "cd ./examples/ReactNativeListPlayground && npm run start",
    "dev:docs": "vitepress dev docs --host",
    "build:docs": "vitepress build docs",
    "preview:docs": "vitepress preview docs"
  },
  "private": true,
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npm run lint:fix",
      "prettier . --write"
    ]
  },
  "packageManager": "pnpm@9.3.0",
  "author": "youchao liu",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@changesets/cli": "^2.27.8",
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "21.1.2",
    "@nx/eslint-plugin": "21.1.2",
    "@nx/jest": "21.1.2",
    "@nx/js": "21.1.2",
    "@nx/react": "21.1.2",
    "@nx/react-native": "21.1.2",
    "@nx/rollup": "21.1.2",
    "@nx/storybook": "21.1.2",
    "@nx/vite": "21.1.2",
    "@nx/web": "21.1.2",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native/babel-preset": "0.76.9",
    "@react-native/metro-config": "0.76.9",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/core-server": "8.6.14",
    "@storybook/jest": "^0.2.3",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/test-runner": "0.22.0",
    "@storybook/testing-library": "^0.2.2",
    "@swc-node/register": "~1.9.1",
