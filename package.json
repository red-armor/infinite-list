    "@babel/runtime": "^7.25.7",
    "@storybook/addon-essentials": "^8.4.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.74.1"
  },
  "nx": {
    "includedScripts": []
  }
}
