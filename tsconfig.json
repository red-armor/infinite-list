{
  "compilerOptions": {
    "baseUrl": "./",
    "rootDir": "./",
    "target": "ES2015",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "module": "commonjs",
    "typeRoots": ["./node_modules/@types"],
    "removeComments": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-native",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitUseStrict": false,
    "noStrictGenericChecks": false,
    "resolveJsonModule": true,
    "allowJs": true,
    "paths": {
      "@infinite-list/base-dimensions": ["core/base-dimensions/src/index.ts"],
      "@infinite-list/container": ["core/container/src/index.ts"],
      "@infinite-list/group": ["ui/group/src/index.ts"],
      "@infinite-list/item-meta": ["core/item-meta/src/index.ts"],
      "@infinite-list/items-dimensions": [
        "model/items-dimensions/src/index.ts"
      ],
      "@infinite-list/list": ["ui/list/src/index.ts"],
      "@infinite-list/list-model": ["core/list-model/src/index.ts"],
      "@infinite-list/masonry": ["ui/masonry/src/index.ts"],
      "@infinite-list/scroller/react-native": ["ui/scroller/src/react-native"],
      "@infinite-list/scroller/web": ["ui/scroller/src/web"],
      "@infinite-list/utils": ["core/utils/src/index.ts"],
      "@infinite-list/viewable": ["core/viewable/src/index.ts"]
    }
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}
