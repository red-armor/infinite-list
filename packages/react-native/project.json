{
  "name": "react-native",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/react-native/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project react --web",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/react-native",
        "main": "packages/react-native/src/index.ts",
        "tsConfig": "packages/react-native/tsconfig.build.json",
        "assets": ["packages/react-native/*.md"]
      }
    }
  }
}
