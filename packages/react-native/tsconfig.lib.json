{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["node"]
  },
  "exclude": [
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test-setup.ts",
    "../data-model",
    "**/data-model/**/*.ts",
    "**/data-model/**/*.tsx",
    "**/data-model/**/*.js",
    "**/data-model/**/*.jsx",
    "@infinite-list/data-model/**/*.ts",
    "@infinite-list/data-model/**/*.tsx",
    "@infinite-list/data-model/**/*.js",
    "@infinite-list/data-model/**/*.jsx",
    "packages/data-model/src/index.ts,",
    "infinite-list/packages/data-model/src/index.ts",
    "data-model/src/index.ts"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"]
}
