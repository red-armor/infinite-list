{
  "name": "eslint-config",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "toolkit/eslint-config/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/rollup:rollup",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/toolkit/eslint-config",
        "tsConfig": "toolkit/eslint-config/tsconfig.lib.json",
        "project": "toolkit/eslint-config/package.json",
        "entryFile": "toolkit/eslint-config/src/index.ts",
        "compiler": "swc",
        "format": ["cjs", "esm"],
        "external": ["react/jsx-runtime", "react-native", "react", "react-dom"],
        "assets": [
          {
            "glob": "toolkit/eslint-config/README.md",
            "input": ".",
            "output": "."
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "toolkit/eslint-config/**/*.{ts,tsx,js,jsx}",
          "toolkit/eslint-config/package.json"
        ]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
