{
  "name": "metro-infinite-list-resolver",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "toolkit/metro-infinite-list-resolver/src",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "dist/{projectRoot}",
        "currentVersionResolver": "git-tag"
      }
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/rollup:rollup",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/toolkit/metro-infinite-list-resolver",
        "tsConfig": "toolkit/metro-infinite-list-resolver/tsconfig.lib.json",
        "project": "toolkit/metro-infinite-list-resolver/package.json",
        "entryFile": "toolkit/metro-infinite-list-resolver/src/index.ts",
        "compiler": "swc",
        "format": ["cjs", "esm"],
        "external": ["react/jsx-runtime", "react-native", "react", "react-dom"],
        "assets": [
          {
            "glob": "toolkit/metro-infinite-list-resolver/README.md",
            "input": ".",
            "output": "."
          }
        ]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
