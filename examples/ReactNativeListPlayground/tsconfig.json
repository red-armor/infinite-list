{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@infinite-list/react-native": ["../../packages/react-native/src"],
      "@infinite-list/masonry": ["../../ui/masonry/src/react-native"],
      "@infinite-list/scroller": ["../../ui/scroller/src/react-native"],
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
}
