{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // "module": "ESNext",
    // "moduleResolution": "Bundler",
    "moduleResolution": "node16",
    "module": "node16",

    "outDir": "../../dist/out-tsc",
    "types": ["node"]
  },
  "exclude": [
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test-setup.ts"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"]
}
