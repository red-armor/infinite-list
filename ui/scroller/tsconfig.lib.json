{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "es2015",
    "moduleResolution": "bundler",

    // "moduleResolution": "node",

    // "moduleResolution": "node16",
    // "module": "node16",

    "outDir": "../../dist/out-tsc",
    "types": ["node"]
  },
  "exclude": [
    "node_modules",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test-setup.ts"
  ],
  "include": ["./src/**/*.js", "./src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"]
}
