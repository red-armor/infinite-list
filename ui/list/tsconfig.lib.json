{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["node"],
    "module": "es2015",
    "moduleResolution": "bundler"
    // "paths": {
    //   "@infinite-list/scroller/react-native": ["../scroller/src/react-native"],
    // }
  },
  "exclude": [
    "node_modules",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.test.ts",
    "src/test-setup.ts"
  ],
  "include": [
    "./src/**/*.js",
    "./src/**/*.jsx",
    "./src/**/*.ts",
    "./src/**/*.tsx"
  ]
}
